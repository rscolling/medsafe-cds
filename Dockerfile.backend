FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
# Non-editable install: MEDSAFE_ROOT tells app.config where rules/ and data/ live.
WORKDIR /srv/medsafe
COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/app backend/app
COPY backend/third_party backend/third_party
RUN pip install ./backend
COPY rules rules
COPY data data
COPY scripts scripts
RUN useradd --system --uid 10001 medsafe && mkdir -p /var/lib/medsafe && chown medsafe /var/lib/medsafe
USER medsafe
ENV MEDSAFE_ROOT=/srv/medsafe MEDSAFE_AUDIT_DB=/var/lib/medsafe/audit.sqlite3
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8080/health').status==200 else 1)"
CMD ["uvicorn", "app.api.app:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8080"]
