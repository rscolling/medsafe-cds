# Copy to .env. These are the PUBLIC demo codes published on the worldvista/vehu Docker Hub page
# for a synthetic training database. They are not secrets and do not give access to any real system.
VISTA_ACCESS_CODE=PRO1234
VISTA_VERIFY_CODE=PRO1234!!
VISTA_HOST=localhost
VISTA_PORT=9430
# auto | live | recorded
MEDSAFE_VISTA_MODE=auto
# fixtures = bundled synthetic patients (explicit default for local demos)
# http     = HAPI FHIR at MEDSAFE_FHIR_BASE_URL; an outage fails open ({"cards": []} + X-Medsafe-Degraded)
# auto     = http if HAPI answers at startup, else fixtures (logged as a WARNING; an outage does NOT fail open)
MEDSAFE_FHIR_MODE=fixtures
MEDSAFE_FHIR_BASE_URL=http://localhost:8090/fhir

# --- Hardening (see README "Security and exposure"). This service is a localhost prototype: do not expose it.
# dev (default) logs loud warnings for insecure defaults; production refuses to start without the two settings below.
MEDSAFE_ENV=dev
# Protects /api/audit, /api/audit/summary and /metrics (send as X-API-Key); also switches /docs off.
# MEDSAFE_AUDIT_API_KEY=
# Salt for pseudonymised patient ids in logs/audit (16+ chars; the built-in default is deliberately weak).
# MEDSAFE_PSEUDONYM_SALT=
# MEDSAFE_MAX_BODY_BYTES=1000000
# MEDSAFE_MAX_DRAFT_ORDERS=50

# --- Clinical time base and VistA safety (see README "VistA live mode")
# auto (today for prefetch, record-anchored for fixtures/VEHU) | today | anchored
# MEDSAFE_AS_OF_POLICY=auto
# MEDSAFE_VISTA_AUTH_COOLDOWN_S=300
# MEDSAFE_VISTA_BREAKER_COOLDOWN_S=15
# MEDSAFE_VISTA_FETCH_DEADLINE_S=10
# MEDSAFE_VISTA_PENDING_ACTIVE=true
# Behind a reverse proxy that sets the real client IP, name the header so rate limits are per client:
# MEDSAFE_CLIENT_IP_HEADER=X-Forwarded-For
